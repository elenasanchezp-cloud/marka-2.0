name: Claude Code - apply request

on:
  issue_comment:
    types: [created]

jobs:
  apply-code:
    runs-on: ubuntu-latest
    if: contains(github.event.comment.body, '/claude apply')
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 18

      - name: Run AI code generator
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          node .github/ai-scripts/claude-code-apply.mjs "${{ github.event.comment.body }}" "${{ github.event.issue.number }}"
