// Generar un brandbook a partir de BRAND.md y abrir un PR con los cambios.
// Usa ANTHROPIC_API_KEY en process.env

import fs from 'fs/promises';
import fetch from 'node-fetch'; // o usa el SDK oficial si existe
import { execSync } from 'child_process';

const [repo, issueNumber] = process.argv.slice(2);

// 1) leer BRAND.md
const brand = await fs.readFile('BRAND.md', 'utf8');

// 2) montar prompt (personaliza según tu CLAUDE.md)
const prompt = `Eres un asistente que, siguiendo BRAND.md, genera un brandbook detallado en Markdown para el proyecto. BRIEF: ${brand}\n
Produce: brandbook.md con secciones: Paleta, Tipografía, Tono, Logo, Uso, Ejemplos.`;

const res = await fetch('https://api.anthropic.com/v1/complete', { // placeholder endpoint
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    'X-API-Key': process.env.ANTHROPIC_API_KEY
  },
  body: JSON.stringify({
    model: 'claude-2.1', // ajusta al modelo que uses
    prompt,
    max_tokens: 4000
  })
});

const body = await res.json();
const brandbookText = body.completion || body.result || JSON.stringify(body);

// 3) escribir archivo en rama nueva
const branch = `ai/brandbook-issue-${issueNumber}`;
execSync(`git checkout -b ${branch}`);
await fs.writeFile('brandbook.md', brandbookText);

// 4) commit y push
execSync('git config user.email "bot@marka"');
execSync('git config user.name "marka-bot"');
execSync('git add brandbook.md');
execSync(`git commit -m "chore: generate brandbook (AI) for issue #${issueNumber}"`);
execSync(`git push origin ${branch}`);

// 5) abrir PR usando GitHub REST via curl (o usa octokit)
const PR_TITLE = `AI: draft brandbook for issue #${issueNumber}`;
const PR_BODY = `Brandbook draft generated by Claude. Please review and adjust.\n\nGenerated from BRAND.md.`;
const repoSlug = process.env.GITHUB_REPOSITORY || repo;

await fetch(`https://api.github.com/repos/${repoSlug}/pulls`, {
  method: 'POST',
  headers: {
    Authorization: `token ${process.env.GITHUB_TOKEN}`,
    'Content-Type': 'application/json',
    'User-Agent': 'marka-bot'
  },
  body: JSON.stringify({
    title: PR_TITLE,
    head: branch,
    base: 'main',
    body: PR_BODY
  })
});
console.log('PR opened for brandbook draft');
